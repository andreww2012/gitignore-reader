{
  "name": "gitignore-reader-x",
  "version": "0.0.1",
  "description": "Reads gitignore rules the way git does: from every source, with exact semantics. Gives a fast matcher and patterns for ESLint and cspell",
  "keywords": [
    "gitignore",
    "git",
    "ignore",
    "info-exclude",
    "excludesfile",
    "gitmodules",
    "eslint",
    "cspell",
    "glob",
    "matcher",
    "check-ignore"
  ],
  "homepage": "https://github.com/andreww2012/gitignore-reader",
  "bugs": {
    "url": "https://github.com/andreww2012/gitignore-reader/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/gitignore-reader.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "nr build",
    "prepublishOnly": "nr check:package",
    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "pnpm self-update",
    "u:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:fix": "nr deps:audit --fix override",
    "deps:audit:fix:update": "nr deps:audit --fix update",
    "check:deps:dedupe": "pnpm dedupe --check",
    "check:deps:peers": "pnpm peers check",
    "check:spelling": "cspell --no-progress --no-summary .",
    "check:format": "oxfmt --check",
    "format": "oxfmt",
    "eslint:inspect": "eslint-config-inspector --open false",
    "eslint": "eslint --cache",
    "ts": "tsc --noEmit",
    "ts6": "tsc6 --noEmit",
    "knip:main": "knip --no-progress",
    "knip:cycles": "knip --no-progress --cycles --reporter cycles",
    "knip": "nr \"/^knip:.+$/\"",
    "check": "nr \"/^(knip|check:(spelling|format)|ts|eslint)$/\"",
    "check:deps": "nr \"/^(deps:audit|check:deps:peers)$/\"",
    "check:deps:strict": "nr \"/^(deps:audit|check:deps:(dedupe|peers))$/\"",
    "check:package": "pnpm pack --out temp/package.tgz && nr check:package:attw && nr check:package:publint",
    "check:package:attw": "attw temp/package.tgz --profile esm-only",
    "check:package:publint": "publint temp/package.tgz --strict",
    "check:fix": "nr format && nr eslint --fix && nr format",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test:templates": "node scripts/test-templates.ts",
    "test": "nr check:deps && nr check && nr test:vitest",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish"
  },
  "dependencies": {
    "quansync": "1.0.0"
  },
  "devDependencies": {
    "@andreww2012/commitlint-config": "0.0.1",
    "@andreww2012/npm-check-updates-config": "0.1.1",
    "@antfu/ni": "30.6.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@eslint/config-inspector": "3.5.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/ui": "5.0.5",
    "actions-up": "2.0.0",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "eslint-config-un": "1.0.0-rc.5",
    "eslint-plugin-github-action": "0.4.0",
    "eslint-plugin-sentences-per-line": "0.1.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "npm-check-updates": "23.1.1",
    "oxfmt": "0.75.0",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "utilery": "0.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0"
    }
  },
  "inlinedDependencies": {
    "utilery": "0.3.0"
  }
}